// rgs Postgres schema — current state as of Flyway V4.
// Source of truth is rgs/src/main/resources/db/migration; update this file in the same PR as any migration.
// View: paste this file into https://dbdiagram.io/d

Project rgs {
  database_type: 'PostgreSQL'
  Note: '''
  Core backend schema for Magv (rgs). Reflects migrations V1__baseline → V4__store_corpus_and_postgres_enums.

  Conventions:
  - `created_at` / `updated_at` are `integer` epoch **seconds**, set by JPA @PrePersist / @PreUpdate.
  - Order lifecycle timestamps and `search_history.searched_at` are `bigint` epoch **milliseconds**.
  - Enum columns are Postgres enums named after the Java enum's simple name, lowercased.
  - Surrogate ids are `GENERATED BY DEFAULT AS IDENTITY`.
  '''
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

Enum corpus {
  PHARMACY
  BAKERY
  DAIRY
  MEAT
}

Enum userrole {
  ADMIN
  STORE_OWNER
  CONSUMER
  DELIVERY_PARTNER
}

Enum storestatus {
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  INACTIVE
  DELETED
}

Enum bankaccounttype {
  SAVINGS
  CURRENT
  FIXED_DEPOSIT
  RECURRING_DEPOSIT
  NRE
  NRO
  FCNR
  SALARY
  SENIOR_CITIZEN
  MINOR
  JAN_DHAN
  DEMAT
}

Enum orderstatus {
  PLACED
  ACCEPTED
  REJECTED
  READY_FOR_PICKUP
  AGENT_ASSIGNED
  PICKED_UP
  DELIVERED
}

Enum addresstype {
  HOME
  WORK
  OTHER
}

Enum resourcetype {
  IMAGE
  VIDEO
  RAW
}

Enum drugtype {
  ALLOPATHY
  AYURVEDA
  HOMEOPATHY
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

Table users {
  user_id integer [pk, increment]
  country_code varchar(5) [not null, default: '+91']
  phone_number varchar(255) [not null]
  role userrole [not null, note: 'Derived from the X-Platform header; one row per (phone, role)']
  user_name varchar(255)
  email varchar(255)
  password varchar(255)
  otp varchar(255)
  otp_expiration timestamp(6)
  created_at integer [not null]
  updated_at integer [not null]

  indexes {
    (country_code, phone_number, role) [unique, name: 'uk_users_country_code_phone_number_role']
  }

  Note: 'Platform-scoped accounts: the same phone number has a separate row per role.'
}

Table address {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.user_id]
  type addresstype
  label varchar(255)
  address_line1 varchar(255) [not null]
  latitude double [not null]
  longitude double [not null]
  receiver_name varchar(255)
  receiver_phone varchar(255)
  is_default boolean [not null]
  is_deleted boolean [not null, note: 'Soft delete']
  created_at integer [not null]
  updated_at integer [not null]
}

Table search_history {
  user_id integer [not null, ref: > users.user_id]
  corpus corpus [not null]
  query varchar(50) [not null]
  searched_at bigint [not null, note: 'Epoch ms, client-supplied']

  indexes {
    (user_id, corpus, query) [pk, name: 'search_history_pkey']
  }

  Note: 'Recent searches per user per corpus. fillfactor = 90 for HOT updates of searched_at.'
}

// ---------------------------------------------------------------------------
// Stores
// ---------------------------------------------------------------------------

Table stores {
  store_id integer [pk, increment]
  user_id integer [not null, ref: > users.user_id, note: 'Store owner']
  corpus corpus [not null, note: 'What kind of store this is; backfilled PHARMACY in V4']
  status storestatus
  store_name varchar(255) [not null]
  owner_name varchar(255) [not null]
  city varchar(255) [not null]
  locality varchar(255) [not null]
  landmark varchar(255)
  lat double [not null]
  lng double [not null]
  s2cell_id bigint [not null, note: 'Google S2 cell of (lat, lng), used for discovery']
  opening_time integer [note: 'Seconds from 00:00 in store-local time (IST today)']
  closing_time integer [note: 'Seconds from 00:00 in store-local time (IST today)']
  operational_days smallint [note: 'Bitmask: bit i set = open, 0 = Monday .. 6 = Sunday']
  alternative_contact_number varchar(255)
  alternative_email varchar(255)
  pan_number varchar(255) [not null]
  name_as_per_pan varchar(255) [not null]
  bank_account_number varchar(255) [not null]
  bank_account_type bankaccounttype [not null]
  ifsc_code varchar(255) [not null]
  asset_id varchar(255) [unique, ref: - assets.asset_id, note: 'Store cover image']
  created_at integer [not null]
  updated_at integer [not null]

  indexes {
    (corpus, s2cell_id) [name: 'stores_corpus_s2cell_id_idx']
  }
}

Table assets {
  asset_id varchar(255) [pk]
  resource_type resourcetype
  resource_url varchar(255) [not null]
  original_file_name varchar(255) [not null]
  file_size integer [not null]
  width integer [not null]
  height integer [not null]
  created_at integer [not null]
  updated_at integer [not null]
}

Table store_images {
  store_id integer [not null, ref: > stores.store_id]
  asset_id varchar(255) [not null, unique, ref: - assets.asset_id]

  Note: 'Gallery images for a store. No primary key; asset_id is unique.'
}

// ---------------------------------------------------------------------------
// Catalog & inventory (pharmacy corpus)
// ---------------------------------------------------------------------------

Table drug_sku {
  id integer [pk, increment]
  name varchar(255)
  type drugtype
  composition text
  manufacturer varchar(255)
  marketer varchar(255)
  pack_size integer
  pack_size_label varchar(255)
  price real [note: 'Catalog reference price; the price charged comes from pharmacy_drug_inventory']
  prescription_required boolean
  discontinued boolean
  image_url text
  created_at integer [not null]
  updated_at integer [not null]

  Note: 'Pharmacy master catalog. A store can only sell SKUs listed here.'
}

Table pharmacy_drug_inventory {
  id integer [pk, increment]
  store_id integer [ref: > stores.store_id]
  sku_id integer [ref: > drug_sku.id]
  selling_price real
  max_retail_price real
  stock integer
  is_available boolean
  created_at integer [not null]
  updated_at integer [not null]

  Note: 'Per-store stock and price for a catalog SKU. No unique (store_id, sku_id).'
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

Table cart {
  cart_id integer [pk, increment]
  user_id integer [not null, ref: > users.user_id]
  store_id integer [not null, ref: > stores.store_id]
  created_at integer [not null]
  updated_at integer [not null]

  Note: 'One cart per (user, store) by convention; not enforced by a unique constraint.'
}

Table cart_item {
  cart_item_id integer [pk, increment]
  cart_id integer [ref: > cart.cart_id]
  sku_id integer [ref: > drug_sku.id, note: 'Master-catalog SKU, not the inventory row']
  quantity integer [not null]
  created_at integer [not null]
  updated_at integer [not null]

  Note: 'No unique (cart_id, sku_id).'
}

// ---------------------------------------------------------------------------
// Orders & delivery
// ---------------------------------------------------------------------------

Table orders {
  order_id integer [pk, increment]
  user_id integer [not null, ref: > users.user_id]
  store_id integer [not null, ref: > stores.store_id]
  address_id integer [not null, ref: > address.id]
  delivery_agent_id integer [ref: > users.user_id, note: 'References users.user_id, not delivery_agents']
  order_status orderstatus [not null]
  rejection_reason varchar(255)
  items_total real [not null]
  discounted_items_total real [not null]
  delivery_partner_fee real
  handling_fee real
  packing_fee real
  platform_fee real
  gst real
  order_placed_at bigint [note: 'Epoch ms']
  order_accepted_or_rejected_at bigint [note: 'Epoch ms']
  order_ready_for_pickup_at bigint [note: 'Epoch ms']
  agent_assigned_at bigint [note: 'Epoch ms']
  order_picked_up_at bigint [note: 'Epoch ms']
  order_delivered_at bigint [note: 'Epoch ms']
}

Table order_items {
  order_item_id integer [pk, increment]
  order_id integer [not null, ref: > orders.order_id]
  sku_id integer [not null, note: 'drug_sku.id, but no foreign key']
  quantity integer [not null]
  item_price real [not null]
  item_discount real
  discounted_item_price real

  Note: 'Price snapshot at order time.'
}

Table delivery_agents {
  delivery_agent_id integer [pk, increment]
  user_id integer [not null, unique, ref: - users.user_id]
  score integer
  fcm_token varchar(512)
  fcm_token_updated_at integer
  created_at integer [not null]
  updated_at integer [not null]
}

// ---------------------------------------------------------------------------
// Groups (colour-coded areas in dbdiagram.io)
// ---------------------------------------------------------------------------

TableGroup user [color: #0EA5E9] {
  users
  delivery_agents
  address
  search_history
  Note: 'User identity and profile: accounts (one row per country code, phone, role), delivery partner profiles, addresses and recent searches.'
}

TableGroup store [color: #8B5CF6] {
  stores
  assets
  store_images
  Note: 'Physical stores and their media. assets is generic media storage, used only by stores today.'
}

TableGroup inventory [color: #10B981] {
  drug_sku
  pharmacy_drug_inventory
  Note: 'Per-corpus master catalog and per-store stock and price. Pharmacy only today.'
}

TableGroup cart [color: #F59E0B] {
  cart
  cart_item
  Note: 'One cart per (user, store); items reference master-catalog SKUs.'
}

TableGroup order [color: #EF4444] {
  orders
  order_items
  Note: 'Placed orders, with a snapshot of the price paid.'
}